# Works immediately without any key. No model or embedding calls occur in demo mode.
RAG_PROVIDER=demo
API_PORT=4100
# Optional API location for the Next.js rewrite. Default is http://127.0.0.1:4100.
API_URL=http://127.0.0.1:4100

# Local AI: install Ollama, pull both models, set RAG_PROVIDER=ollama, then restart.
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_CHAT_MODEL=llama3.2:3b
OLLAMA_EMBED_MODEL=nomic-embed-text

# Hosted AI: set RAG_PROVIDER=openai and provide your own server-side key.
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4.1-mini
OPENAI_EMBED_MODEL=text-embedding-3-small

# disk = exact cosine search over persisted vectors; qdrant = external vector DB.
VECTOR_STORE=disk
QDRANT_URL=http://127.0.0.1:6333
QDRANT_API_KEY=
# Thresholds are model-dependent; evaluate this value, do not treat it as confidence.
MIN_SIMILARITY=0.3

# Optional local fine-tuning workflow (independent of the RAG model provider).
FINETUNE_MODEL=mlx-community/Qwen2.5-0.5B-Instruct-4bit
# FINETUNE_PYTHON=/absolute/path/to/.venv-finetune/bin/python
# Enable only after you start both MLX inference servers; this never starts training.
FINETUNE_COMPARE_ENABLED=false
FINETUNE_BASE_URL=http://127.0.0.1:8081/v1
FINETUNE_TUNED_URL=http://127.0.0.1:8082/v1
